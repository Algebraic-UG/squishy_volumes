{
    "tasks": [
        {
            "label": "Rebuild local for tests",
            "type": "shell",
            "command": "./scripts/rebuild_zip.sh"
        },
        {
            "label": "build-assets",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "../scripts/build_assets.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}/python"
            }
        },
        {
            "label": "build-node-trees",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "nodebpy",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}/python"
            }
        }
    ]
}